[Unit]
Description=wstgo client (TCP over WebSocket tunnel, multi-forward)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 推荐配置文件模式（v0.3.0+）：本地多端口监听，各连服务端对应标签的转发
# 配置模板见 deploy/wstgo-client.toml.example，复制到 /etc/wstgo/ 后按需修改
ExecStart=/usr/local/bin/wstgo run -config /etc/wstgo/wstgo-client.toml

# 单隧道场景可改用 CLI 子命令（与上面配置文件模式的最小形态等价）：
# ExecStart=/usr/local/bin/wstgo client \
#     -bind 127.0.0.1:25432 \
#     -url wss://tunnel.example.com/ws \
#     -key /etc/wstgo/client/private.pem
# 自签名 wss 场景推荐追加: -cacert /etc/wstgo/ca-root.crt（配置文件模式对应 cacert 字段）
# 临时调试才用 -insecure（配置文件模式对应 allow_insecure = true，与 cacert 互斥）

# 配置、私钥等文件建议放 /etc/wstgo 下，与下方 ProtectSystem=strict 兼容（仍可读）
Restart=always
RestartSec=3

# 基础加固：全文件系统只读、禁止提权、私有 /tmp
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
